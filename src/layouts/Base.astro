---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { identity, seo, socials, skillGroups } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Las páginas de error no deben indexarse. */
  noindex?: boolean;
}

const {
  title = seo.title,
  description = seo.description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

/**
 * JSON-LD. Solo hechos confirmados: nombre, rol, ubicación, perfiles y
 * competencias. Sin premios, sin empleadores no verificados, sin métricas.
 */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.fullName,
  alternateName: identity.shortName,
  url: canonical,
  image: ogImage,
  jobTitle: identity.role,
  email: `mailto:${identity.email}`,
  telephone: identity.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Getafe',
    addressRegion: 'Madrid',
    addressCountry: 'ES',
  },
  nationality: { '@type': 'Country', name: 'Venezuela' },
  knowsLanguage: [
    { '@type': 'Language', name: 'Español' },
    { '@type': 'Language', name: 'Inglés' },
  ],
  knowsAbout: skillGroups.flatMap((g) => g.items),
  sameAs: socials.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: seo.shortTitle,
  url: Astro.site?.href,
  inLanguage: 'es-ES',
  author: { '@type': 'Person', name: identity.fullName },
};
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="author" content={identity.fullName} />
    <meta name="theme-color" content="#04010f" />
    <meta name="color-scheme" content="dark" />

    {
      /* El SVG cubre a los navegadores modernos; los PNG están para iOS y
        para los clientes que ignoran el favicon vectorial. Se regeneran
        con `npm run icons` a partir del propio favicon.svg. */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={seo.shortTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`Portafolio de ${identity.fullName}, ${identity.role}`}
    />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      /* is:inline evita que Astro los trate como scripts a empaquetar.
        Un bloque ld+json es datos, no código: el navegador no lo ejecuta
        y la CSP no lo bloquea. */
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(siteSchema)}
    />

    <!-- Sin JS los reveals nunca se animarían y el contenido quedaría
         invisible. Esta hoja los fuerza a visible. Es un archivo externo
         y no un <style> inline a propósito: así la CSP puede prohibir
         scripts inline sin excepciones. -->
    <noscript><link rel="stylesheet" href="/noscript.css" /></noscript>
  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-cyan focus:text-ink focus:px-5 focus:py-3 focus:font-display focus:text-xs focus:font-bold focus:tracking-widest"
      >SALTAR AL CONTENIDO</a
    >

    <!-- Capas de fondo. Puramente decorativas: fuera del árbol accesible. -->
    <canvas id="scene" class="fixed inset-0 -z-10" aria-hidden="true"></canvas>
    <div
      aria-hidden="true"
      class="anim-grid pointer-events-none fixed inset-0 -z-[9]"
      style="background-image:linear-gradient(rgb(0 240 255/.055) 1px,transparent 1px),linear-gradient(90deg,rgb(0 240 255/.055) 1px,transparent 1px);background-size:64px 64px;-webkit-mask-image:radial-gradient(ellipse at center,#000 20%,transparent 78%);mask-image:radial-gradient(ellipse at center,#000 20%,transparent 78%)"
    >
    </div>
    <div
      id="cursor-glow"
      aria-hidden="true"
      class="pointer-events-none fixed -z-[8] hidden h-[520px] w-[520px] mix-blend-screen md:block"
      style="background:radial-gradient(circle,rgb(0 240 255/.10) 0%,rgb(255 47 214/.05) 40%,transparent 70%);will-change:transform"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 z-40 opacity-[.10]"
      style="background:repeating-linear-gradient(180deg,rgb(0 0 0/.55) 0 1px,transparent 1px 3px)"
    >
    </div>

    <div
      id="progress"
      aria-hidden="true"
      class="fixed top-0 left-0 z-[60] h-[3px] w-full origin-left scale-x-0"
      style="background:linear-gradient(90deg,var(--color-cyan),var(--color-magenta),var(--color-violet));box-shadow:0 0 12px var(--color-cyan)"
    >
    </div>

    <Nav />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
