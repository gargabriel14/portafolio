---
import { identity } from '../data/profile';

const links = [
  { href: '#inicio', label: 'INICIO' },
  { href: '#sobre-mi', label: 'SOBRE MÍ' },
  { href: '#skills', label: 'SKILLS' },
  { href: '#proyectos', label: 'PROYECTOS' },
  { href: '#trayectoria', label: 'TRAYECTORIA' },
  { href: '#contacto', label: 'CONTACTO' },
];
---

<header
  id="nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-cyan/15 backdrop-blur-xl transition-colors duration-500"
  style="background:linear-gradient(180deg,rgb(4 1 15/.85),rgb(4 1 15/.4))"
>
  <nav
    aria-label="Navegación principal"
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5"
  >
    <a
      href="#inicio"
      class="font-display text-base font-black tracking-[.2em] text-white transition-opacity hover:opacity-80"
    >
      <span class="text-cyan">◢</span>
      {identity.brand.prefix}<span class="text-magenta"
        >{identity.brand.suffix}</span
      >
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              data-nav-link
              class="nav-link relative py-1.5 font-display text-[.68rem] font-bold tracking-[.2em] text-muted transition-colors duration-300 hover:text-cyan"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="#contacto"
        class="btn hidden !px-5 !py-2.5 !text-[.68rem] sm:inline-flex"
      >
        HABLEMOS
      </a>
      <button
        id="burger"
        type="button"
        class="grid h-10 w-10 place-items-center border border-cyan/40 text-cyan lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span
          class="relative block h-[2px] w-5 bg-current transition-all duration-300 before:absolute before:-top-1.5 before:left-0 before:h-[2px] before:w-5 before:bg-current before:transition-all before:duration-300 after:absolute after:top-1.5 after:left-0 after:h-[2px] after:w-5 after:bg-current after:transition-all after:duration-300"
        ></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="grid grid-rows-[0fr] overflow-hidden transition-[grid-template-rows] duration-500 lg:hidden"
    style="background:rgb(4 1 15/.97)"
  >
    <ul class="min-h-0">
      {
        links.map((l) => (
          <li class="border-t border-cyan/10">
            <a
              href={l.href}
              data-nav-link
              data-mobile-link
              class="nav-link block px-6 py-4 font-display text-xs font-bold tracking-[.22em] text-muted transition-colors hover:text-cyan"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .nav-link.is-active {
    color: #fff;
    text-shadow: 0 0 14px var(--color-cyan);
  }
  .nav-link.is-active::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -2px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-cyan), var(--color-magenta));
    box-shadow: 0 0 10px var(--color-cyan);
  }
  /* En móvil el subrayado del enlace activo estorba: es una lista, no una barra. */
  @media (max-width: 1023px) {
    .nav-link.is-active::after {
      display: none;
    }
  }
  #mobile-menu.is-open {
    grid-template-rows: 1fr;
  }
  #burger.is-open span {
    background: transparent;
  }
  #burger.is-open span::before {
    transform: translateY(6px) rotate(45deg);
  }
  #burger.is-open span::after {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
