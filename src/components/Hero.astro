---
import { identity, intro, stats, availability } from '../data/profile';
import Icon from './Icon.astro';
---

<section
  id="inicio"
  class="relative flex min-h-svh items-center justify-center overflow-hidden px-5 pt-24 pb-16"
>
  <!-- Anillos orbitales, decorativos -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 grid place-items-center"
  >
    <div
      class="anim-spin-slow absolute h-[560px] w-[560px] rounded-full border border-dashed border-cyan/25 md:h-[680px] md:w-[680px]"
    >
    </div>
    <div
      class="anim-spin-rev absolute h-[760px] w-[760px] rounded-full border border-dashed border-magenta/20 md:h-[900px] md:w-[900px]"
    >
    </div>
  </div>

  {
    /* Velo radial entre el fondo 3D y el texto. Sin él, el núcleo brillante
      queda justo detrás del párrafo y lo vuelve ilegible. */
  }
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background:radial-gradient(ellipse 55% 42% at 50% 48%,rgb(4 1 15/.82) 0%,rgb(4 1 15/.55) 45%,transparent 72%)"
  >
  </div>

  <div class="relative w-full max-w-5xl text-center">
    <p
      data-reveal
      class="mb-6 font-display text-[.62rem] font-bold tracking-[.4em] text-cyan sm:text-[.7rem]"
    >
      [ <span class="anim-blink">●</span>
      {availability.status.toUpperCase()} — {identity.location.toUpperCase()} ]
    </p>

    <h1
      data-reveal
      class="glitch font-display text-[clamp(2.1rem,8.5vw,6.5rem)] leading-[0.95] font-black tracking-[.04em] text-white"
      data-text={identity.shortName.toUpperCase()}
    >
      {identity.shortName.toUpperCase()}
    </h1>

    <p
      data-reveal
      class="mt-5 font-display text-[clamp(.7rem,2.4vw,1.15rem)] font-bold tracking-[.32em] text-magenta"
    >
      {identity.role.toUpperCase()}
    </p>

    <p
      data-reveal
      class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl"
    >
      {intro.lead}
    </p>

    <div
      data-reveal
      class="mt-9 flex flex-wrap items-center justify-center gap-4"
    >
      <a href="#proyectos" class="btn" data-magnetic>
        VER PROYECTOS
        <Icon name="arrow" size={16} />
      </a>
      <a href="#contacto" class="btn btn-ghost" data-magnetic>CONTACTAR</a>
    </div>

    <!-- Chips flotantes: solo en pantallas donde hay sitio real -->
    <div aria-hidden="true" class="pointer-events-none hidden xl:block">
      <span class="anim-float chip absolute top-16 -left-4">⬢ WORDPRESS</span>
      <span
        class="anim-float chip absolute top-40 -right-6"
        style="animation-delay:1.1s">⬢ REACT</span
      >
      <span
        class="anim-float chip absolute bottom-36 -left-2"
        style="animation-delay:2.2s">⬢ TYPESCRIPT</span
      >
      <span
        class="anim-float chip absolute right-2 bottom-52"
        style="animation-delay:1.7s">⬢ SEO</span
      >
    </div>

    <!-- Contadores. Cada cifra es verificable; no hay vanity metrics. -->
    <dl
      data-reveal
      class="mx-auto mt-14 grid max-w-3xl grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4"
    >
      {
        stats.map((s, i) => (
          <div class="text-center">
            <dd
              class:list={[
                'font-display text-3xl font-black tabular-nums sm:text-4xl',
                ['text-cyan', 'text-magenta', 'text-violet', 'text-white'][
                  i % 4
                ],
              ]}
              data-count={s.value}
              data-suffix={s.suffix}
            >
              0
            </dd>
            {/* Dentro de un <dl>, un <div> solo puede contener <dt> y <dd>.
                Un <p> suelto aquí rompe la estructura y axe lo marca como
                incidencia seria, así que la aclaración va dentro del <dt>. */}
            <dt class="mt-1.5">
              <span class="block font-display text-[.6rem] font-bold tracking-[.28em] text-dim">
                {s.label.toUpperCase()}
              </span>
              <span class="mt-1 block text-xs font-medium text-dim">
                {s.hint}
              </span>
            </dt>
          </div>
        ))
      }
    </dl>

    <a
      href="#sobre-mi"
      class="mt-14 inline-flex flex-col items-center gap-2 text-cyan transition-opacity hover:opacity-70"
      aria-label="Bajar a la siguiente sección"
    >
      <span
        class="flex h-9 w-5 justify-center rounded-full border border-cyan pt-1.5"
      >
        <span class="anim-cue h-2 w-[3px] rounded bg-cyan"></span>
      </span>
      <span class="font-display text-[.55rem] font-bold tracking-[.35em]"
        >DESLIZA</span
      >
    </a>
  </div>
</section>

<style>
  /* Glitch cromático sobre el nombre. Es el único efecto puramente
     estético del hero, y se apaga entero con reduced-motion. */
  .glitch {
    position: relative;
    display: inline-block;
  }
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .glitch::before {
    color: var(--color-cyan);
    opacity: 0.8;
    animation: glitch-a 2.9s infinite steps(2, end);
  }
  .glitch::after {
    color: var(--color-magenta);
    opacity: 0.8;
    animation: glitch-b 3.4s infinite steps(2, end);
  }

  @keyframes glitch-a {
    0%,
    90% {
      clip-path: inset(0 0 68% 0);
      transform: translate(-2px, -2px);
    }
    92% {
      clip-path: inset(15% 0 40% 0);
      transform: translate(-6px, 2px);
    }
    95% {
      clip-path: inset(55% 0 8% 0);
      transform: translate(5px, -2px);
    }
    98% {
      clip-path: inset(5% 0 75% 0);
      transform: translate(-4px, 1px);
    }
    100% {
      clip-path: inset(0 0 68% 0);
      transform: translate(-2px, -2px);
    }
  }
  @keyframes glitch-b {
    0%,
    88% {
      clip-path: inset(60% 0 0 0);
      transform: translate(2px, 2px);
    }
    91% {
      clip-path: inset(30% 0 30% 0);
      transform: translate(6px, -1px);
    }
    94% {
      clip-path: inset(8% 0 60% 0);
      transform: translate(-5px, 2px);
    }
    97% {
      clip-path: inset(70% 0 5% 0);
      transform: translate(4px, -2px);
    }
    100% {
      clip-path: inset(60% 0 0 0);
      transform: translate(2px, 2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch::before,
    .glitch::after {
      display: none;
    }
  }
</style>
