---
import { identity, intro, stats, availability } from '../data/profile';
import Icon from './Icon.astro';

const [primero, ...resto] = identity.shortName.toUpperCase().split(' ');
---

{
  /* La versión anterior centraba absolutamente todo: título, párrafo,
    botones y contadores en un mismo eje. Esa simetría perfecta es la
    marca de nacimiento de una plantilla — no hay ninguna decisión de
    composición, solo un centrado. Aquí el bloque de texto ocupa la
    izquierda, la ficha se descuelga a la derecha y los contadores se
    apoyan en una línea, así que el ojo tiene un recorrido en vez de un
    eje. */
}
<section
  id="inicio"
  class="relative flex min-h-svh items-center overflow-hidden px-5 pt-28 pb-16"
>
  <!-- Anillos orbitales, descentrados hacia la derecha -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div
      class="anim-spin-slow absolute top-1/2 right-[-14%] h-[560px] w-[560px] -translate-y-1/2 rounded-full border border-dashed border-cyan/20 md:h-[720px] md:w-[720px]"
    >
    </div>
    <div
      class="anim-spin-rev absolute top-1/2 right-[-22%] h-[760px] w-[760px] -translate-y-1/2 rounded-full border border-dashed border-magenta/15 md:h-[920px] md:w-[920px]"
    >
    </div>
  </div>

  <!-- Velo: sin él el núcleo 3D queda detrás del párrafo y lo vuelve ilegible -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background:radial-gradient(ellipse 70% 60% at 34% 50%,rgb(4 1 15/.88) 0%,rgb(4 1 15/.6) 45%,transparent 76%)"
  >
  </div>

  <div class="relative mx-auto w-full max-w-6xl">
    <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-10">
      <!-- Bloque principal -->
      <div class="lg:col-span-8">
        <p
          data-reveal
          class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[.66rem] font-bold tracking-[.22em] text-cyan sm:text-[.72rem]"
        >
          <span class="anim-blink">●</span>
          <span>{availability.status.toUpperCase()}</span>
          <span aria-hidden="true" class="text-dim">/</span>
          <span class="text-dim">{identity.location.toUpperCase()}</span>
        </p>

        {
          /* El glitch va por LÍNEA, no sobre el h1: las capas ::before y
            ::after copian data-text, y con el nombre partido en dos
            renglones un único data-text se pintaría en una sola línea y
            quedaría descuadrado sobre el texto real. */
        }
        <h1
          data-reveal
          class="mt-6 font-display text-[clamp(2.6rem,11vw,7.5rem)] leading-[0.86] font-black tracking-[-.01em] text-white"
        >
          {
            /* El espacio explícito no es cosmético: sin él el textContent del
              h1 es "GABRIELGARCÍA" de una pieza, y así lo lee un lector de
              pantalla y así lo indexa un buscador. */
          }
          <span class="glitch block" data-text={primero}>{primero}{' '}</span>
          <span class="glitch block text-magenta" data-text={resto.join(' ')}
            >{resto.join(' ')}</span
          >
        </h1>

        <div data-reveal class="mt-8 flex items-start gap-4">
          <span
            aria-hidden="true"
            class="mt-3 hidden h-px w-14 shrink-0 bg-cyan sm:block"
            style="box-shadow:0 0 10px var(--color-cyan)"></span>
          <div class="max-w-xl">
            <p
              class="font-display text-[clamp(.72rem,2vw,1rem)] font-bold tracking-[.24em] text-cyan"
            >
              {identity.role.toUpperCase()}
            </p>
            <p class="mt-4 text-lg leading-relaxed text-muted sm:text-xl">
              {intro.lead}
            </p>
          </div>
        </div>

        <div data-reveal class="mt-10 flex flex-wrap items-center gap-4">
          <a href="#proyectos" class="btn" data-magnetic>
            VER PROYECTOS
            <Icon name="arrow" size={16} />
          </a>
          <a href="#contacto" class="btn btn-ghost" data-magnetic>ESCRÍBEME</a>
        </div>
      </div>

      <!-- Ficha lateral, descolgada -->
      <aside
        data-reveal
        class="lg:col-span-4 lg:mt-16 lg:border-l lg:border-cyan/20 lg:pl-8"
      >
        <p class="font-mono text-[.62rem] font-bold tracking-[.22em] text-dim">
          EN CORTO
        </p>

        <dl class="mt-5 grid grid-cols-2 gap-x-6 lg:grid-cols-1 lg:gap-y-0">
          {
            stats.map((s, i) => (
              <div
                class:list={[
                  'border-cyan/12 py-3.5',
                  i > 0 && 'border-t',
                  i > 1 && 'lg:border-t',
                  'max-lg:odd:border-r max-lg:odd:pr-6',
                ]}
              >
                <dd
                  class:list={[
                    'font-display text-2xl font-black tabular-nums sm:text-3xl',
                    ['text-cyan', 'text-magenta', 'text-violet', 'text-white'][
                      i % 4
                    ],
                  ]}
                  data-count={s.value}
                  data-suffix={s.suffix}
                >
                  0
                </dd>
                {/* Dentro de un <dl>, un <div> solo admite <dt> y <dd>. Un <p>
                    suelto aquí rompe la estructura y axe lo marca como
                    incidencia seria, así que la aclaración va dentro del <dt>. */}
                <dt class="mt-1">
                  <span class="block font-mono text-[.6rem] font-bold tracking-[.18em] text-dim">
                    {s.label.toUpperCase()}
                  </span>
                  <span class="mt-0.5 block text-xs font-medium text-dim">
                    {s.hint}
                  </span>
                </dt>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>

    <a
      href="#sobre-mi"
      data-reveal
      class="mt-16 inline-flex items-center gap-3 text-cyan transition-opacity hover:opacity-70"
      aria-label="Bajar a la siguiente sección"
    >
      <span
        class="flex h-8 w-5 justify-center rounded-full border border-cyan pt-1.5"
      >
        <span class="anim-cue h-1.5 w-[3px] rounded bg-cyan"></span>
      </span>
      <span class="font-mono text-[.6rem] font-bold tracking-[.22em]"
        >SIGUE BAJANDO</span
      >
    </a>
  </div>

  <!-- Chips flotantes: solo donde hay sitio de sobra -->
  <div aria-hidden="true" class="pointer-events-none hidden xl:block">
    <span class="anim-float chip absolute top-32 right-24">⬢ WORDPRESS</span>
    <span
      class="anim-float chip absolute right-10 bottom-40"
      style="animation-delay:1.4s">⬢ REACT</span
    >
    <span
      class="anim-float chip absolute right-52 bottom-24"
      style="animation-delay:2.4s">⬢ SEO</span
    >
  </div>
</section>

<style>
  /* Glitch cromático sobre el nombre.
     Clave: en REPOSO las capas están recortadas a cero. Antes se quedaban
     visibles con un desplazamiento fijo, y el nombre se veía doblado todo
     el rato — parecía un error de renderizado, no un efecto. Ahora solo
     asoman en tres instantes de cada ciclo. */
  .glitch {
    position: relative;
  }
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
    clip-path: inset(50% 0 50% 0);
  }
  .glitch::before {
    color: var(--color-cyan);
    opacity: 0.9;
    animation: glitch-a 5.5s infinite steps(1, end);
  }
  .glitch::after {
    color: var(--color-magenta);
    opacity: 0.85;
    animation: glitch-b 6.7s infinite steps(1, end);
  }

  @keyframes glitch-a {
    0%,
    100% {
      clip-path: inset(50% 0 50% 0);
      transform: translate(0, 0);
    }
    91% {
      clip-path: inset(12% 0 62% 0);
      transform: translate(-5px, -1px);
    }
    93% {
      clip-path: inset(50% 0 50% 0);
      transform: translate(0, 0);
    }
    95% {
      clip-path: inset(58% 0 22% 0);
      transform: translate(4px, 1px);
    }
    97% {
      clip-path: inset(50% 0 50% 0);
      transform: translate(0, 0);
    }
  }
  @keyframes glitch-b {
    0%,
    100% {
      clip-path: inset(50% 0 50% 0);
      transform: translate(0, 0);
    }
    88% {
      clip-path: inset(64% 0 14% 0);
      transform: translate(5px, 2px);
    }
    90% {
      clip-path: inset(50% 0 50% 0);
      transform: translate(0, 0);
    }
    94% {
      clip-path: inset(20% 0 54% 0);
      transform: translate(-6px, -2px);
    }
    96% {
      clip-path: inset(50% 0 50% 0);
      transform: translate(0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch::before,
    .glitch::after {
      display: none;
    }
  }
</style>
